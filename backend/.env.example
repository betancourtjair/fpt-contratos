# FPT Contratos - Backend - variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores.

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma. Usa "*" para permitir cualquiera (solo dev).
CORS_ORIGIN=*

# --- Base de datos (Postgres, vía node-postgres / pg, sin ORM) ---
DATABASE_URL=postgresql://fpt_app:fpt_dev_pw@localhost:5432/fpt_contratos

# --- Autenticación JWT ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Almacenamiento de archivos ---
# Backend de almacenamiento de documentos. Por ahora solo "local" está implementado;
# la capa src/storage.js está preparada para agregar "s3" en el futuro sin tocar rutas.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# --- Notificaciones por correo (Microsoft Graph API, client credentials flow) ---
# Si estas variables no están configuradas, src/email.js opera en "modo dev":
# solo hace console.log del correo que se enviaría, sin tronar el proceso.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_SENDER_EMAIL=

# URL pública del sitio (frontend), usada en el correo de bienvenida al crear un usuario.
# Si se omite, se usa el dominio de GitHub Pages por default.
FRONTEND_URL=https://betancourtjair.github.io/fpt-contratos/

# --- Firma electrónica (Documenso — self-hosted, firma electrónica SIMPLE, NO NOM-151) ---
# Sin estas dos variables, la integración queda desactivada (los endpoints de "enviar a
# firmar" devuelven error 400 y el job periódico no hace nada).
# DOCUMENSO_URL: URL base de tu instancia de Documenso (self-hosted), SIN "/" al final
# (ej. https://firmas.fpt.com.mx). DOCUMENSO_API_TOKEN: se genera dentro de esa instancia ya
# levantada, en ícono de usuario > Configuración de equipo > API Tokens (requiere un "Team";
# una cuenta personal de Documenso no puede generar tokens de API).
DOCUMENSO_URL=
DOCUMENSO_API_TOKEN=
# Opcional pero recomendado: secreto que también se da de alta dentro de la instancia de
# Documenso (Configuración de equipo > Webhooks), junto con la URL del webhook:
# https://<este-backend>/api/webhooks/documenso. Sin esto, el webhook acepta cualquier llamada.
DOCUMENSO_WEBHOOK_SECRET=

# --- Keep-alive (cron externo para evitar que Render duerma el backend y Documenso) ---
# Si se configura, el endpoint GET /api/keep-alive exige que este valor coincida (header
# X-Keep-Alive-Secret o query param secret=) antes de ejecutar nada. Si se omite, el
# endpoint acepta cualquier llamada (no recomendado para producción).
KEEP_ALIVE_SECRET=

# --- Seed ---
# Password temporal para el usuario super_admin inicial creado por prisma/seed.js.
# Si se omite, el seed genera uno aleatorio y lo imprime en consola.
SEED_SUPERADMIN_PASSWORD=
