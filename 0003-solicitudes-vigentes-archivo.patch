 frontend/src/App.jsx                          |  9 ++-
 frontend/src/components/Layout.jsx            |  4 +-
 .../src/pages/contratos/DetalleContrato.jsx   |  3 +-
 .../src/pages/contratos/ListaContratos.jsx    | 80 ++++++++++++++++---
 .../src/pages/contratos/NuevaSolicitud.jsx    |  2 +-
 6 files changed, 92 insertions(+), 17 deletions(-)

