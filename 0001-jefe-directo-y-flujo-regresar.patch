+  esJefeDirectoSolicitante Boolean @default(false) // aprobador = jefe directo de quien levantó ESTE contrato
+  permiteRegresar     Boolean     @default(true) // false en el primer paso del diagrama acordado (jefe directo)
   montoMinimo         Decimal?    @db.Decimal(14, 2)
   montoMaximo         Decimal?    @db.Decimal(14, 2)
   obligatorio         Boolean     @default(true)
@@ -174,6 +180,7 @@ model ContratoAprobacion {
